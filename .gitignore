# ACE EMS Monorepo - Git Ignore Rules

# Dependencies (anywhere in the monorepo)
node_modules/
.pnp
.pnp.*
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/
.nyc_output/

# Next.js (for all Next.js apps)
.next/
out/
dist/

# Production builds
build/
.vercel/

# Environment files (all levels)
.env
.env*.local
.env.development
.env.staging
.env.production
.env.test

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
.cache/

# Package manager lock files (optional - uncomment if needed)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Monorepo specific
apps/*/.next/
apps/*/out/
apps/*/build/
apps/*/dist/
packages/*/build/
packages/*/dist/

# Development utilities
.turbo/
.eslintcache
