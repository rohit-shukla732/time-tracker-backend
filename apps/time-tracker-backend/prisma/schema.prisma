generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  name         String?
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  refreshTokens     RefreshToken[]
  sessions          Session[]
  sessionSummaries  SessionSummary[]
  appUsage          SessionAppUsage[]
  events            Event[]
  appSwitchEvents   AppSwitchEvent[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  startedAt   DateTime
  endedAt     DateTime?
  autoClockOut Boolean @default(false)
  autoReason  String?
  rawStartEvent Json?
  rawEndEvent   Json?

  createdAt DateTime @default(now())

  summary   SessionSummary?
  appUsage  SessionAppUsage[]
  events    Event[]
  appSwitch AppSwitchEvent[]
}

model SessionSummary {
  id                String   @id @default(uuid())
  sessionId         String   @unique
  session           Session  @relation(fields: [sessionId], references: [sessionId])

  userId            String?
  user              User?    @relation(fields: [userId], references: [id])

  sessionDurationMs BigInt
  totalBreakMs      BigInt
  totalIdleMs       BigInt
  workTimeMs        BigInt

  createdAt         DateTime @default(now())
}

model SessionAppUsage {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  appName    String
  timeMs     BigInt

  createdAt  DateTime @default(now())
}

model Event {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  type       String
  reason     String?
  durationMs BigInt?

  timestamp  DateTime
  epochMs    BigInt

  payload    Json
  createdAt  DateTime @default(now())
}

model AppSwitchEvent {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  fromApp    String?
  toApp      String?
  durationMs BigInt?

  timestamp  DateTime
  epochMs    BigInt

  payload    Json
  createdAt  DateTime @default(now())
}