{
  "name": "ace-ems",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ace-ems/time-tracker-backend",
    "dev:admin": "npm run dev --workspace=@ace-ems/admin",
    "dev:all": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "npm run clean --workspaces",
    "type-check": "npm run type-check --workspaces",
    "db:generate": "npm run db:generate --workspace=@ace-ems/time-tracker-backend",
    "db:push": "npm run db:push --workspace=@ace-ems/time-tracker-backend",
    "db:migrate": "npm run db:migrate --workspace=@ace-ems/time-tracker-backend",
    "db:reset": "npm run db:reset --workspace=@ace-ems/time-tracker-backend"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "prisma": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
