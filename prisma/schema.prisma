generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  HR
  EMPLOYEE
}

enum Pronoun {
  MR
  MS
  MRS
  MISS
  DR
  PROF
  MX
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum JobType {
  FULL_TIME
  CONTRACTUAL
  PART_TIME
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  RESIGNED
  TERMINATED
  RETIRED
  ABSCONDED
}

enum AccountType {
  SAVINGS
  CURRENT
  SALARY
  NRE
  NRO
}

enum TransferType {
  NEFT
  RTGS
  IMPS
  UPI
}

enum AccountBase {
  Primary
  Secondary
}
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum TicketCategory {
  IT_SUPPORT
}

enum ITSupportSubcategory {
  HARDWARE
  SOFTWARE
  NETWORK
  EMAIL
  ACCESS
  PRINTER
  PHONE
  OTHER
}

enum TaskStatus {
  PENDING_APPROVAL
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  MATERNITY
  PATERNITY
  UNPAID
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// HR Management Models
model Company {
  id             String           @id @default(uuid())
  name           String
  code           String?          @unique
  branches       Branch[]
  employmentInfo EmploymentInfo[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

// Personal Information Table
model PersonalInfo {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  middleName  String?
  lastName    String
  pronoun     Pronoun?
  gender      Gender?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Contact Information Table
model ContactInfo {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                String   @unique
  alternateEmail       String?
  phoneNumber          String?
  alternatePhoneNumber String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@index([email])
}

// Address Information Table
model AddressInfo {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  residentialAddress String?
  permanentAddress   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Family Information Table
model FamilyInfo {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  maritalStatus MaritalStatus?
  fatherName    String?
  spouseName    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Government ID Information Table
model GovernmentID {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  panCardNumber    String?  @unique
  aadharCardNumber String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([panCardNumber])
  @@index([aadharCardNumber])
}

// Employment Information Table
model EmploymentInfo {
  id                  String          @id @default(uuid())
  userId              String          @unique
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId           String?
  company             Company?        @relation(fields: [companyId], references: [id])
  branchId            String?
  branch              Branch?         @relation(fields: [branchId], references: [id])
  departmentId        String?
  department          Department?     @relation(fields: [departmentId], references: [id])
  designationId       String?
  designation         Designation?    @relation(fields: [designationId], references: [id])
  jobType             JobType?
  status              EmployeeStatus  @default(ACTIVE)
  joiningDate         DateTime?
  confirmationDate    DateTime?       // Same as joining or after probation
  probationEndDate    DateTime?
  lastIncrementDate   DateTime?
  resignationDate     DateTime?
  lastWorkingDate     DateTime?
  retiringDate        DateTime?       // Derived based on service months
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([designationId])
  @@index([status])
}

// Bank Details Table
model BankDetails {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName        String
  accountNumber   String        @unique
  accountType     AccountType?
  accountBase     AccountBase?       // Primary or Secondary
  transferType    TransferType?
  beneficiaryName String        // Name as per bank account
  ifscCode        String
  branchName      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([accountNumber])
  @@index([ifscCode])
}

model Branch {
  id             String           @id @default(uuid())
  name           String
  code           String?          @unique
  address        String?
  city           String?
  state          String?
  country        String?
  pincode        String?
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  employmentInfo EmploymentInfo[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  
  @@unique([companyId, name])
}

model Department {
  id             String           @id @default(uuid())
  name           String           @unique
  code           String?          @unique
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  
  // Department manager
  managerId      String?          @unique
  manager        User?            @relation("DepartmentManager", fields: [managerId], references: [id])
  
  // Department members (via EmploymentInfo)
  employmentInfo EmploymentInfo[]
  
  // Task management (previously team-based)
  projects       Project[]
  tasks          Task[]
}

model Designation {
  id             String           @id @default(uuid())
  title          String           @unique
  code           String?          @unique
  level          Int?             // Hierarchy level
  employmentInfo EmploymentInfo[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model User {
  id           String          @id
  
  // Core Identity (for display only - detailed info in PersonalInfo)
  name         String          // Full name for quick display
  email        String          @unique  // For authentication
  
  // Authentication
  passwordHash String
  role         Role            @default(EMPLOYEE)
  
  // System fields
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  
  // Normalized Relations (One-to-One)
  personalInfo     PersonalInfo?
  contactInfo      ContactInfo?
  addressInfo      AddressInfo?
  familyInfo       FamilyInfo?
  governmentID     GovernmentID?
  employmentInfo   EmploymentInfo?
  bankDetails      BankDetails?
  
  // Department management (if user is a manager)
  managedDepartment Department?  @relation("DepartmentManager")

  refreshTokens     RefreshToken[]
  sessions          Session[]
  sessionSummaries  SessionSummary[]
  appUsage          SessionAppUsage[]
  websiteUsage      SessionWebsiteUsage[]
  websiteVisits     WebsiteVisit[]
  events            Event[]
  appSwitchEvents   AppSwitchEvent[]
  deviceControl     DeviceControl?
  
  // Ticketing system
  createdTickets    Ticket[]         @relation("TicketCreator")
  assignedTickets   Ticket[]         @relation("TicketAssignee")
  ticketComments    TicketComment[]
  
  // Task management
  createdProjects   Project[]        @relation("ProjectCreator")
  createdTasks      Task[]           @relation("TaskCreator")
  assignedTasks     Task[]           @relation("TaskAssignee")
  approvedTasks     Task[]           @relation("TaskApprover")
  taskSessions      TaskSession[]
  
  // Leave management
  leaveRequests     LeaveRequest[]   @relation("LeaveRequestor")
  approvedLeaves    LeaveRequest[]   @relation("LeaveApprover")
  leaveBalance      LeaveBalance?
  lateComingRecords LateComingRecord[]
  
  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([email])
  @@index([token])
}

model Session {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  startedAt   DateTime
  endedAt     DateTime?
  autoClockOut Boolean @default(false)
  autoReason  String?
  rawStartEvent Json?
  rawEndEvent   Json?

  createdAt DateTime @default(now())

  summary          SessionSummary?
  appUsage         SessionAppUsage[]
  websiteUsage     SessionWebsiteUsage[]
  websiteVisits    WebsiteVisit[]
  events           Event[]
  appSwitch        AppSwitchEvent[]
  taskSessions     TaskSession[]
}

model SessionSummary {
  id                String   @id @default(uuid())
  sessionId         String   @unique
  session           Session  @relation(fields: [sessionId], references: [sessionId])

  userId            String?
  user              User?    @relation(fields: [userId], references: [id])

  sessionDurationMs BigInt
  totalBreakMs      BigInt
  totalIdleMs       BigInt
  workTimeMs        BigInt

  createdAt         DateTime @default(now())
}

model SessionAppUsage {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  appName    String
  timeMs     BigInt

  createdAt  DateTime @default(now())
}

model Event {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  type       String
  reason     String?
  durationMs BigInt?

  timestamp  DateTime
  epochMs    BigInt

  payload    Json
  createdAt  DateTime @default(now())
}

model AppSwitchEvent {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  fromApp    String?
  toApp      String?
  durationMs BigInt?

  timestamp  DateTime
  epochMs    BigInt

  payload    Json
  createdAt  DateTime @default(now())
}

model WebsiteVisit {
  id           String   @id @default(uuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [sessionId])

  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  fromWebsite  String?
  toWebsite    String?
  durationMs   BigInt?
  browser      String?

  timestamp    DateTime
  epochMs      BigInt?

  payload      Json?
  createdAt    DateTime @default(now())
  
  @@index([sessionId])
  @@index([userId])
  @@index([toWebsite])
  @@index([browser])
}

model SessionWebsiteUsage {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  website    String
  browser    String?
  timeMs     BigInt

  createdAt  DateTime @default(now())
  
  @@index([sessionId])
  @@index([userId])
}

// Device control for remote force-stop/resume
model DeviceControl {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  forceStop   Boolean  @default(false)
  reason      String?
  stoppedBy   String?  // Admin ID who initiated the stop
  stoppedAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
// Ticketing System Models
model Ticket {
  id           String                 @id @default(uuid())
  ticketNumber Int                    @unique @default(autoincrement())
  title        String
  description  String
  priority     TicketPriority         @default(MEDIUM)
  status       TicketStatus           @default(OPEN)
  category     TicketCategory         @default(IT_SUPPORT)
  subcategory  ITSupportSubcategory?
  
  createdBy    String
  creator      User                   @relation("TicketCreator", fields: [createdBy], references: [id])
  
  assignedTo   String?
  assignee     User?                  @relation("TicketAssignee", fields: [assignedTo], references: [id])
  
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  resolvedAt   DateTime?
  
  comments     TicketComment[]
  screenshots  TicketScreenshot[]
  
  @@index([createdBy])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([ticketNumber])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  content   String
  isInternal Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([ticketId])
  @@index([userId])
}

model TicketScreenshot {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  filename  String
  url       String
  size      Int
  mimeType  String
  
  createdAt DateTime @default(now())
  
  @@index([ticketId])
}

// Task Management Models
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  
  createdById String
  createdBy   User     @relation("ProjectCreator", fields: [createdById], references: [id])
  
  startDate   DateTime?
  endDate     DateTime?
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tasks       Task[]
  
  @@index([departmentId])
  @@index([createdById])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id])
  
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  
  assignedTo  String?
  assignee    User?        @relation("TaskAssignee", fields: [assignedTo], references: [id])
  
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  
  approvedById String?
  approvedBy   User?       @relation("TaskApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  
  status      TaskStatus   @default(PENDING_APPROVAL)
  priority    TaskPriority @default(MEDIUM)
  
  estimatedHours Float?
  
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  taskSessions TaskSession[]
  
  @@index([projectId])
  @@index([departmentId])
  @@index([assignedTo])
  @@index([createdById])
  @@index([status])
}

model TaskSession {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [sessionId])
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  startedAt   DateTime
  endedAt     DateTime?
  durationMs  BigInt?
  
  createdAt   DateTime @default(now())
  
  @@index([taskId])
  @@index([sessionId])
  @@index([userId])
}

model LeaveRequest {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation("LeaveRequestor", fields: [userId], references: [id])
  
  type        LeaveType
  status      LeaveStatus @default(PENDING)
  
  startDate   DateTime
  endDate     DateTime
  days        Float       // Support half days (0.5, 1, 1.5, etc.)
  
  reason      String
  attachment  String?     // File path for medical certificates, etc.
  
  approvedById String?
  approvedBy   User?      @relation("LeaveApprover", fields: [approvedById], references: [id])
  
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectionReason String?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model LeaveBalance {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  sickLeave       Float @default(0)      // Annual sick leave quota
  casualLeave     Float @default(0)      // Annual casual leave quota
  annualLeave     Float @default(0)      // Annual/vacation leave quota
  maternityLeave  Float @default(0)     // Maternity leave quota (in days)
  paternityLeave  Float @default(0)       // Paternity leave quota
  compensatoryOff Float @default(0)       // Earned comp-offs
  
  sickUsed        Float @default(0)
  casualUsed      Float @default(0)
  annualUsed      Float @default(0)
  maternityUsed   Float @default(0)
  paternityUsed   Float @default(0)
  compensatoryUsed Float @default(0)
  
  year        Int      // Leave balance year
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, year])
  @@index([userId])
  @@index([year])
}

model LeaveSettings {
  id                    String   @id @default(uuid())
  
  // Monthly leave allocation
  monthlySickLeave      Float    @default(0)  // Sick leave allocated per month
  monthlyCasualLeave    Float    @default(0)  // Casual leave allocated per month
  monthlyAnnualLeave    Float    @default(0)  // Annual leave allocated per month
  
  // Rollover settings
  allowMonthlyRollover  Boolean  @default(false)  // Allow unused monthly leaves to rollover to next month
  allowYearlyRollover   Boolean  @default(false)  // Allow unused yearly leaves to rollover to next year
  
  // Maximum rollover limits
  maxMonthlyRollover    Float?   // Max leaves that can be rolled over monthly
  maxYearlyRollover     Float?   // Max leaves that can be rolled over yearly
  
  // Annual defaults (for reference/initial setup)
  annualSickLeave       Float    @default(0)
  annualCasualLeave     Float    @default(0)
  annualAnnualLeave     Float    @default(0)
  annualMaternityLeave  Float    @default(0)
  annualPaternityLeave  Float    @default(0)
  
  // Late coming settings
  lateComingCredits     Int      @default(0)     // Total late coming credits in minutes per month
  lateThresholdMinutes  Int      @default(15)    // Minutes late before counting as late (e.g., 15 mins grace period)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("leave_settings")
}

model LateComingRecord {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  
  year                Int      // Year of the record
  month               Int      // Month (1-12)
  
  creditsUsed         Int      @default(0)  // Total minutes of late coming used this month
  lateCount           Int      @default(0)  // Number of times late this month
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@unique([userId, year, month])
  @@index([userId])
  @@index([year, month])
  @@map("late_coming_records")
}

// HR Configuration
model HRSettings {
  id                    String   @id @default(uuid())
  
  // Service configuration
  maxServiceMonths      Int      @default(720)  // Default 60 years (720 months)
  retirementAge         Int?     // Optional retirement age
  probationMonths       Int      @default(6)    // Default 6 months probation
  
  // Notice period configuration
  noticePeriodDays      Int      @default(30)   // Default 30 days
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("hr_settings")
}
