generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id             String           @id @default(uuid())
  name           String
  code           String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  branches       Branch[]
  employmentInfo EmploymentInfo[]
}

model PersonalInfo {
  id          String    @id @default(uuid())
  userId      String    @unique
  firstName   String
  middleName  String?
  lastName    String
  pronoun     Pronoun?
  gender      Gender?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactInfo {
  id                   String   @id @default(uuid())
  userId               String   @unique
  email                String   @unique
  alternateEmail       String?
  phoneNumber          String?
  alternatePhoneNumber String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model AddressInfo {
  id                 String   @id @default(uuid())
  userId             String   @unique
  residentialAddress String?
  permanentAddress   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FamilyInfo {
  id            String         @id @default(uuid())
  userId        String         @unique
  maritalStatus MaritalStatus?
  fatherName    String?
  spouseName    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GovernmentID {
  id               String   @id @default(uuid())
  userId           String   @unique
  panCardNumber    String?  @unique
  aadharCardNumber String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([panCardNumber])
  @@index([aadharCardNumber])
}

model EmploymentInfo {
  id                String         @id @default(uuid())
  userId            String         @unique
  companyId         String?
  branchId          String?
  departmentId      String?
  designationId     String?
  jobType           JobType?
  status            EmployeeStatus @default(ACTIVE)
  joiningDate       DateTime?
  confirmationDate  DateTime?
  probationEndDate  DateTime?
  lastIncrementDate DateTime?
  resignationDate   DateTime?
  lastWorkingDate   DateTime?
  retiringDate      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  branch            Branch?        @relation(fields: [branchId], references: [id])
  company           Company?       @relation(fields: [companyId], references: [id])
  department        Department?    @relation(fields: [departmentId], references: [id])
  designation       Designation?   @relation(fields: [designationId], references: [id])
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@index([designationId])
  @@index([status])
}

model BankDetails {
  id              String        @id @default(uuid())
  userId          String        @unique
  bankName        String
  accountNumber   String        @unique
  accountType     AccountType?
  accountBase     AccountBase?
  transferType    TransferType?
  beneficiaryName String
  ifscCode        String
  branchName      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountNumber])
  @@index([ifscCode])
}

model Branch {
  id             String           @id @default(uuid())
  name           String
  code           String?          @unique
  address        String?
  city           String?
  state          String?
  country        String?
  pincode        String?
  companyId      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        Company          @relation(fields: [companyId], references: [id])
  employmentInfo EmploymentInfo[]

  @@unique([companyId, name])
}

model Department {
  id             String           @id @default(uuid())
  name           String           @unique
  code           String?          @unique
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  managerId      String?          @unique
  manager        User?            @relation("DepartmentManager", fields: [managerId], references: [id])
  employmentInfo EmploymentInfo[]
  projects       Project[]
  tasks          Task[]
}

model Designation {
  id             String           @id @default(uuid())
  title          String           @unique
  code           String?          @unique
  level          Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  employmentInfo EmploymentInfo[]
}

model User {
  id                 String                @id
  name               String
  email              String                @unique
  passwordHash       String
  role               Role                  @default(EMPLOYEE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  lateThresholdMins  Int?                  @default(15)
  shiftStartTime     String?
  addressInfo        AddressInfo?
  appSwitchEvents    AppSwitchEvent[]
  assignedAssetsBy   AssetAssignment[]     @relation("AssetAssigner")
  assignedAssets     AssetAssignment[]     @relation("AssetAssignee")
  bankDetails        BankDetails?
  contactInfo        ContactInfo?
  managedDepartments Department?           @relation("DepartmentManager")
  deviceControl      DeviceControl?
  employmentInfo     EmploymentInfo?
  events             Event[]
  familyInfo         FamilyInfo?
  governmentID       GovernmentID?
  leaveBalance       LeaveBalance?
  approvedLeaves     LeaveRequest[]        @relation("LeaveApprover")
  leaveRequests      LeaveRequest[]        @relation("LeaveRequestor")
  notifications      Notification[]
  personalInfo       PersonalInfo?
  createdProjects    Project[]             @relation("ProjectCreator")
  refreshTokens      RefreshToken[]
  sessions           Session[]
  appUsage           SessionAppUsage[]
  sessionSummaries   SessionSummary[]
  websiteUsage       SessionWebsiteUsage[]
  approvedTasks      Task[]                @relation("TaskApprover")
  assignedTasks      Task[]                @relation("TaskAssignee")
  createdTasks       Task[]                @relation("TaskCreator")
  taskSessions       TaskSession[]
  assignedTickets    Ticket[]              @relation("TicketAssignee")
  createdTickets     Ticket[]              @relation("TicketCreator")
  ticketComments     TicketComment[]
  websiteVisits      WebsiteVisit[]
  lateComingRecords  LateComingRecord[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Session {
  id            String                @id @default(uuid())
  sessionId     String                @unique
  userId        String?
  startedAt     DateTime
  endedAt       DateTime?
  autoClockOut  Boolean               @default(false)
  autoReason    String?
  rawStartEvent Json?
  rawEndEvent   Json?
  createdAt     DateTime              @default(now())
  appSwitch     AppSwitchEvent[]
  events        Event[]
  user          User?                 @relation(fields: [userId], references: [id])
  appUsage      SessionAppUsage[]
  summary       SessionSummary?
  websiteUsage  SessionWebsiteUsage[]
  taskSessions  TaskSession[]
  websiteVisits WebsiteVisit[]
}

model SessionSummary {
  id                String   @id @default(uuid())
  sessionId         String   @unique
  userId            String?
  sessionDurationMs BigInt
  totalBreakMs      BigInt
  totalIdleMs       BigInt
  workTimeMs        BigInt
  createdAt         DateTime @default(now())
  session           Session  @relation(fields: [sessionId], references: [sessionId])
  user              User?    @relation(fields: [userId], references: [id])
}

model SessionAppUsage {
  id        String   @id @default(uuid())
  sessionId String
  userId    String?
  appName   String
  timeMs    BigInt
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [sessionId])
  user      User?    @relation(fields: [userId], references: [id])
}

model Event {
  id         String   @id @default(uuid())
  sessionId  String
  userId     String?
  type       String
  reason     String?
  durationMs BigInt?
  timestamp  DateTime
  epochMs    BigInt
  payload    Json
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [sessionId])
  user       User?    @relation(fields: [userId], references: [id])
}

model AppSwitchEvent {
  id         String   @id @default(uuid())
  sessionId  String
  userId     String?
  fromApp    String?
  toApp      String?
  durationMs BigInt?
  timestamp  DateTime
  epochMs    BigInt
  payload    Json
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [sessionId])
  user       User?    @relation(fields: [userId], references: [id])
}

model WebsiteVisit {
  id          String   @id @default(uuid())
  sessionId   String
  userId      String?
  fromWebsite String?
  toWebsite   String?
  durationMs  BigInt?
  browser     String?
  timestamp   DateTime
  epochMs     BigInt?
  payload     Json?
  createdAt   DateTime @default(now())
  session     Session  @relation(fields: [sessionId], references: [sessionId])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
  @@index([toWebsite])
  @@index([browser])
}

model SessionWebsiteUsage {
  id        String   @id @default(uuid())
  sessionId String
  userId    String?
  website   String
  browser   String?
  timeMs    BigInt
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [sessionId])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([sessionId])
  @@index([userId])
}

model DeviceControl {
  id          String    @id @default(uuid())
  userId      String    @unique
  forceStop   Boolean   @default(false)
  forceStart  Boolean   @default(false)
  reason      String?
  stoppedBy   String?
  stoppedAt   DateTime?
  startedBy   String?
  startedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
}

model Ticket {
  id           String                @id @default(uuid())
  title        String
  description  String
  priority     TicketPriority        @default(MEDIUM)
  status       TicketStatus          @default(OPEN)
  category     TicketCategory        @default(IT_SUPPORT)
  subcategory  ITSupportSubcategory?
  createdBy    String
  assignedTo   String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  resolvedAt   DateTime?
  ticketNumber Int                   @unique @default(autoincrement())
  assignee     User?                 @relation("TicketAssignee", fields: [assignedTo], references: [id])
  creator      User                  @relation("TicketCreator", fields: [createdBy], references: [id])
  comments     TicketComment[]
  screenshots  TicketScreenshot[]

  @@index([createdBy])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([ticketNumber])
}

model TicketComment {
  id         String   @id @default(uuid())
  ticketId   String
  userId     String
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
}

model TicketScreenshot {
  id        String   @id @default(uuid())
  ticketId  String
  filename  String
  url       String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Project {
  id           String     @id @default(uuid())
  name         String
  description  String?
  createdById  String
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  departmentId String
  createdBy    User       @relation("ProjectCreator", fields: [createdById], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  tasks        Task[]

  @@index([departmentId])
  @@index([createdById])
}

model Task {
  id             String        @id @default(uuid())
  title          String
  description    String?
  projectId      String?
  assignedTo     String?
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  status         TaskStatus    @default(PENDING_APPROVAL)
  priority       TaskPriority  @default(MEDIUM)
  estimatedHours Float?
  dueDate        DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  departmentId   String?
  approvedBy     User?         @relation("TaskApprover", fields: [approvedById], references: [id])
  assignee       User?         @relation("TaskAssignee", fields: [assignedTo], references: [id])
  createdBy      User          @relation("TaskCreator", fields: [createdById], references: [id])
  department     Department?   @relation(fields: [departmentId], references: [id])
  project        Project?      @relation(fields: [projectId], references: [id])
  taskSessions   TaskSession[]

  @@index([projectId])
  @@index([departmentId])
  @@index([assignedTo])
  @@index([createdById])
  @@index([status])
}

model TaskSession {
  id         String    @id @default(uuid())
  taskId     String
  sessionId  String
  userId     String
  startedAt  DateTime
  endedAt    DateTime?
  durationMs BigInt?
  createdAt  DateTime  @default(now())
  session    Session   @relation(fields: [sessionId], references: [sessionId])
  task       Task      @relation(fields: [taskId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([sessionId])
  @@index([userId])
}

model LeaveRequest {
  id              String      @id @default(uuid())
  userId          String
  type            LeaveType
  status          LeaveStatus @default(PENDING)
  startDate       DateTime
  endDate         DateTime
  days            Float
  reason          String
  attachment      String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  approvedBy      User?       @relation("LeaveApprover", fields: [approvedById], references: [id])
  user            User        @relation("LeaveRequestor", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model LeaveBalance {
  id               String   @id @default(uuid())
  userId           String   @unique
  sickLeave        Float    @default(0)
  casualLeave      Float    @default(0)
  annualLeave      Float    @default(0)
  maternityLeave   Float    @default(0)
  paternityLeave   Float    @default(0)
  compensatoryOff  Float    @default(0)
  sickUsed         Float    @default(0)
  casualUsed       Float    @default(0)
  annualUsed       Float    @default(0)
  maternityUsed    Float    @default(0)
  paternityUsed    Float    @default(0)
  compensatoryUsed Float    @default(0)
  year             Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@unique([userId, year])
  @@index([userId])
  @@index([year])
}

model LeaveSettings {
  id                   String   @id @default(uuid())
  monthlySickLeave     Float    @default(0)
  monthlyCasualLeave   Float    @default(0)
  monthlyAnnualLeave   Float    @default(0)
  allowMonthlyRollover Boolean  @default(false)
  allowYearlyRollover  Boolean  @default(false)
  maxMonthlyRollover   Float?
  maxYearlyRollover    Float?
  annualSickLeave      Float    @default(0)
  annualCasualLeave    Float    @default(0)
  annualAnnualLeave    Float    @default(0)
  annualMaternityLeave Float    @default(0)
  annualPaternityLeave Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  lateComingCredits    Int      @default(0)
  lateThresholdMinutes Int      @default(15)

  @@map("leave_settings")
}

model LateComingRecord {
  id          String   @id @default(uuid())
  userId      String
  year        Int
  month       Int
  creditsUsed Int      @default(0)
  lateCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@index([userId])
  @@index([year, month])
  @@map("late_coming_records")
}

model HRSettings {
  id               String   @id @default(uuid())
  maxServiceMonths Int      @default(720)
  retirementAge    Int?
  probationMonths  Int      @default(6)
  noticePeriodDays Int      @default(30)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("hr_settings")
}

model Asset {
  id                 String             @id @default(uuid())
  assetType          AssetType
  category           AssetCategory
  name               String
  description        String?
  serialNumber       String?            @unique
  model              String?
  manufacturer       String?
  purchaseDate       DateTime?
  warrantyExpiry     DateTime?
  purchaseCost       Float?
  currentValue       Float?
  status             AssetStatus        @default(AVAILABLE)
  location           String?
  notes              String?
  // Laptop peripherals
  monitorName        String?
  monitorCount       Int?
  keyboardName       String?
  mouseName          String?
  headphoneName      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  assignments        AssetAssignment[]
  maintenanceRecords AssetMaintenance[]

  @@index([assetType])
  @@index([category])
  @@index([status])
  @@index([serialNumber])
}

model AssetAssignment {
  id                 String           @id @default(uuid())
  assetId            String
  userId             String
  assignedBy         String
  assignedDate       DateTime         @default(now())
  returnedDate       DateTime?
  expectedReturnDate DateTime?
  status             AssignmentStatus @default(ACTIVE)
  condition          AssetCondition?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  asset              Asset            @relation(fields: [assetId], references: [id])
  assignedByUser     User             @relation("AssetAssigner", fields: [assignedBy], references: [id])
  user               User             @relation("AssetAssignee", fields: [userId], references: [id])

  @@index([assetId])
  @@index([userId])
  @@index([status])
}

model AssetMaintenance {
  id              String            @id @default(uuid())
  assetId         String
  maintenanceType MaintenanceType
  description     String
  scheduledDate   DateTime
  completedDate   DateTime?
  cost            Float?
  performedBy     String?
  status          MaintenanceStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  asset           Asset             @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([status])
  @@index([scheduledDate])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

enum Role {
  ADMIN
  MANAGER
  HR
  EMPLOYEE
}

enum Pronoun {
  MR
  MS
  MRS
  MISS
  DR
  PROF
  MX
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum JobType {
  FULL_TIME
  CONTRACTUAL
  PART_TIME
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  RESIGNED
  TERMINATED
  RETIRED
  ABSCONDED
}

enum AccountType {
  SAVINGS
  CURRENT
  SALARY
  NRE
  NRO
}

enum TransferType {
  NEFT
  RTGS
  IMPS
  UPI
}

enum AccountBase {
  Primary
  Secondary
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum TicketCategory {
  IT_SUPPORT
}

enum ITSupportSubcategory {
  HARDWARE
  SOFTWARE
  NETWORK
  EMAIL
  ACCESS
  PRINTER
  PHONE
  OTHER
}

enum TaskStatus {
  PENDING_APPROVAL
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeaveType {
  SICK
  CASUAL
  ANNUAL
  MATERNITY
  PATERNITY
  UNPAID
  COMPENSATORY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AssetType {
  USER_SIDE
  IT_INFRASTRUCTURE
}

enum AssetCategory {
  LAPTOP
  KEYBOARD
  MOUSE
  HEADSET
  MONITOR
  SWITCH
  FIREWALL
  ACCESS_POINT
  BIOMETRIC
  TELEPHONE_MATRIX
  TELEPHONE_HANDSET
  CCTV_CAMERA
  NVR
  INTERNET_LINE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  RETIRED
  DAMAGED
  LOST
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  UPGRADE
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationType {
  LATE_ARRIVAL
  TASK_ASSIGNED
  TASK_COMPLETED
  TICKET_ASSIGNED
  TICKET_UPDATED
  LEAVE_APPROVED
  LEAVE_REJECTED
  GENERAL
}
