generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  HR
  EMPLOYEE
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Team manager
  managerId   String?
  manager     User?    @relation("TeamManager", fields: [managerId], references: [id])

  // Team members
  members     User[]   @relation("TeamMember")

  @@unique([name])
}

model User {
  id           String          @id
  name         String?
  email        String          @unique
  passwordHash String
  role         Role            @default(EMPLOYEE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  // Team relationships
  teamId       String?
  team         Team?           @relation("TeamMember", fields: [teamId], references: [id])
  managedTeams Team[]          @relation("TeamManager")

  refreshTokens     RefreshToken[]
  sessions          Session[]
  sessionSummaries  SessionSummary[]
  appUsage          SessionAppUsage[]
  events            Event[]
  appSwitchEvents   AppSwitchEvent[]
  deviceControl     DeviceControl?
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Session {
  id          String   @id @default(uuid())
  sessionId   String   @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])

  startedAt   DateTime
  endedAt     DateTime?
  autoClockOut Boolean @default(false)
  autoReason  String?
  rawStartEvent Json?
  rawEndEvent   Json?

  createdAt DateTime @default(now())

  summary   SessionSummary?
  appUsage  SessionAppUsage[]
  events    Event[]
  appSwitch AppSwitchEvent[]
}

model SessionSummary {
  id                String   @id @default(uuid())
  sessionId         String   @unique
  session           Session  @relation(fields: [sessionId], references: [sessionId])

  userId            String?
  user              User?    @relation(fields: [userId], references: [id])

  sessionDurationMs BigInt
  totalBreakMs      BigInt
  totalIdleMs       BigInt
  workTimeMs        BigInt

  createdAt         DateTime @default(now())
}

model SessionAppUsage {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  appName    String
  timeMs     BigInt

  createdAt  DateTime @default(now())
}

model Event {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  type       String
  reason     String?
  durationMs BigInt?

  timestamp  DateTime
  epochMs    BigInt

  payload    Json
  createdAt  DateTime @default(now())
}

model AppSwitchEvent {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session @relation(fields: [sessionId], references: [sessionId])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  fromApp    String?
  toApp      String?
  durationMs BigInt?

  timestamp  DateTime
  epochMs    BigInt

  payload    Json
  createdAt  DateTime @default(now())
}

// Device control for remote force-stop/resume
model DeviceControl {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  forceStop   Boolean  @default(false)
  reason      String?
  stoppedBy   String?  // Admin ID who initiated the stop
  stoppedAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}